# Copy this file to .env and fill in real values before running the server.

# Long random string used to sign login session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Port the API server listens on.
PORT=4000

# Comma-separated list of origins allowed to call this API (your frontend's URL).
# Local dev default matches `npm run dev` in the project root (Vite on 8002).
# In dev the Vite proxy means the browser never calls this origin directly,
# but keep it accurate for when you open the app directly against the API.
# https://localhost and capacitor://localhost are the origins the packaged
# Android/iOS app calls from - keep both if you're testing the mobile build.
CORS_ORIGIN=http://localhost:8002,https://localhost,capacitor://localhost,https://mill-project.vercel.app

# Where the SQLite database file is stored. Defaults to server/data/alagiri.db.
# On Render this MUST point at an attached Disk (mount path /var/data), otherwise
# all data is lost on every deploy:
# DB_PATH=/var/data/alagiri.db

# Password for the seeded `admin` and `employee` accounts, used ONLY the first time
# the database is created (empty DB). Set this on any real deployment - the
# built-in default (Password123!) is public in this repository.
# SEED_PASSWORD=

# Meta WhatsApp Cloud API integration (supplier availability requests).
# From the Meta App Dashboard -> WhatsApp -> API Setup / System User tokens.
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
# Any string you invent - must match what you enter as the webhook's
# Verify Token in the App Dashboard.
META_WEBHOOK_VERIFY_TOKEN=
# App Dashboard -> Settings -> Basic -> App Secret. Used to validate the
# X-Hub-Signature-256 header on inbound webhook calls.
META_APP_SECRET=
# Name + language code of the approved "is this material available?"
# quick-reply template, created in WhatsApp Manager -> Message Templates.
META_AVAILABILITY_TEMPLATE_NAME=
META_TEMPLATE_LANGUAGE=en_US

# File storage on Amazon S3 (request attachments, LR copies, proof of receipt).
# Leave S3_BUCKET empty to keep files inline in the database (fine for local dev).
# On EC2 use an IAM role attached to the instance - no access keys needed.
S3_BUCKET=
S3_REGION=ap-south-1
# S3_ENDPOINT=   # only for tests against an S3-compatible emulator
