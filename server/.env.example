# ============================================================
# Mill Mate App Backend (.env.example)
# Copy this file to .env and fill in real values before running.
# ============================================================

# Server Port (listen on process.env.PORT, default: 4000)
PORT=4000

# Long random string used to sign login session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Comma-separated list of origins allowed to call this API (your frontend's URL).
CORS_ORIGIN=http://localhost:8002,http://localhost:5173,https://localhost,capacitor://localhost,https://mill-project.vercel.app

# Public base URL of backend API for links sent to Meta/WhatsApp (must begin with https:// in production)
PUBLIC_BASE_URL=https://api.yourdomain.com

# Where the SQLite database file is stored. Defaults to server/data/alagiri.db.
# On Render attach a persistent disk and set: DB_PATH=/var/data/alagiri.db
DB_PATH=

# Password for initial seed accounts (admin & employee).
SEED_PASSWORD=

# ------------------------------------------------------------
# Meta WhatsApp Cloud API & Webhook Configuration
# ------------------------------------------------------------
# Meta WhatsApp Cloud API Access Token (System User or User Access Token)
# (Also accepts alias: WHATSAPP_TOKEN)
META_ACCESS_TOKEN=

# WhatsApp Cloud API Phone Number ID (from WhatsApp -> API Setup)
# (Also accepts alias: PHONE_NUMBER_ID)
META_PHONE_NUMBER_ID=

# Meta WhatsApp Business Account ID (WABA ID)
META_WABA_ID=

# Meta Webhook Verification Token (custom secret defined in Meta App Dashboard -> WhatsApp -> Configuration)
# (Also accepts alias: VERIFY_TOKEN)
META_WEBHOOK_VERIFY_TOKEN=

# Meta App Secret (from App Dashboard -> App Settings -> Basic -> App Secret)
# Used to verify the X-Hub-Signature-256 HMAC header on inbound webhook POSTs.
# (Also accepts alias: APP_SECRET)
META_APP_SECRET=

# WhatsApp Flow IDs
META_FLOW_ID=
META_DISPATCH_FLOW_ID=

# WhatsApp Template Names & Config
META_AVAILABILITY_TEMPLATE_NAME=
META_AVAILABILITY_TEMPLATE_LANGUAGE=
META_PO_TEMPLATE_NAME=
META_DISPATCH_DAY_TEMPLATE_NAME=
META_OVERDUE_TEMPLATE_NAME=
META_PENDING_TEMPLATE_NAME=
META_SUMMARY_TEMPLATE_NAME=
META_TEMPLATE_LANGUAGE=en_US

# Scheduled Automation & Dry-Run Flags
MORNING_JOB_CRON=
WHATSAPP_DRY_RUN=
WHATSAPP_AVAILABILITY_ENABLED=

# ------------------------------------------------------------
# Amazon S3 File Storage (Optional)
# ------------------------------------------------------------
# Leave S3_BUCKET empty to keep attachments inline in SQLite database
S3_BUCKET=
S3_REGION=ap-south-1
# S3_ENDPOINT=
