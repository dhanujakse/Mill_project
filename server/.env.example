# Copy this file to .env and fill in real values before running the server.

# Long random string used to sign login session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Port the API server listens on.
PORT=4000

# Comma-separated list of origins allowed to call this API (your frontend's URL).
# Local dev default matches `npm run dev` in the project root (Vite on 8002).
# In dev the Vite proxy means the browser never calls this origin directly,
# but keep it accurate for when you open the app directly against the API.
# https://localhost and capacitor://localhost are the origins the packaged
# Android/iOS app calls from - keep both if you're testing the mobile build.
CORS_ORIGIN=http://localhost:8002,https://localhost,capacitor://localhost,https://mill-project.vercel.app

# Optional: override where the SQLite database file is stored.
# Defaults to server/data/alagiri.db
# DB_PATH=/var/data/alagiri.db
