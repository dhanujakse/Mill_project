# Frontend build-time config. Copy to .env if you need to override the default.
#
# Not needed for local dev (`npm run dev` / `npm run dev:all`) - the Vite dev
# server proxies /api to the backend automatically (see vite.config.js).
#
# Set this when building for production if the backend is not served from the
# same origin as the frontend (e.g. frontend on Vercel/Netlify, backend on Render):
# VITE_API_BASE_URL=https://your-backend.example.com/api
